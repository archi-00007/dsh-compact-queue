{
  "name": "dsh-command-queue",
  "version": "0.2.2",
  "description": "DSH 插件：让 /compact 这类需要 agent 空闲的斜杠命令在忙碌时进入命令队列、空闲后自动执行（默认只排 compact，其余命令一律立即执行）；并在浏览器里以复刻原生队列的样式展示这份队列。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "slash-command",
    "queue",
    "compact"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuyueliuhun-ctrl/dsh-command-queue.git"
  },
  "homepage": "https://github.com/kuyueliuhun-ctrl/dsh-command-queue#readme",
  "bugs": {
    "url": "https://github.com/kuyueliuhun-ctrl/dsh-command-queue/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node --check lib/index.js && node --check lib/client.js && node --test tests/queue.test.mjs tests/client-bundle.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
